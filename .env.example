# Copy to .env and fill in real values (`.env` is gitignored).
# docker-compose.yml / docker-compose-nas.yml read these.

# PostgreSQL password (also used to build DATABASE_URL for the api service)
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# JWT signing secret — generate with: openssl rand -hex 32
SECRET_KEY=

# Only needed when running the backend outside docker-compose:
# DATABASE_URL=postgresql://productdb_user:<POSTGRES_PASSWORD>@localhost:5432/productdb
